[Unit]
X-Watcher-Name=backup
X-Watcher-State=/home/levi/.local/state/backup/last-result
X-Watcher-MaxAge=36h
X-Watcher-Schedule=nightly, step 1
OnFailure=watcher-notify@%n.service
Description=Nightly encrypted system backup to Google Drive (restic + rclone)
Wants=network-online.target
After=network-online.target

[Service]
# Runs as ROOT (since 2026-11-27): the credentials in /etc/backup are root-only, so nothing running as levi can read
# or delete the backups. Writes into levi's home are done as levi inside the script.
Type=oneshot
ExecStartPre=/usr/local/bin/system-backup root-stage
ExecStart=/usr/local/bin/system-backup run
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=8h

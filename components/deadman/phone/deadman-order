#!/bin/bash
# deadman-order — runs ON THE PHONE (Pixel Terminal app). Signs an order with your deadman key and sends it to the laptop.
#   deadman-order test      prove the chain works (changes nothing; you get a "test OK" email)
#   deadman-order locate    email the laptop's location now
#   deadman-order lost      email its location every 10 min until: deadman-order found
#   deadman-order lock      lock screen, end desktop sessions, disable password logins (deadman-order unlock to undo)
#   deadman-order scrub     delete secrets: backup password, Drive/GitHub logins, SSH keys, browser profiles; log out of Tailscale
#   deadman-order wipe      destroy the disk encryption keys (all data unrecoverable) and power off — asks you to type a phrase
#   deadman-order trust     the network the laptop is on NOW is home: no away alerts there (send it while the laptop is home)
#   deadman-order untrust   stop trusting the network the laptop is on now
#   deadman-order away-pause 3d   pause away alerts for 1h–30d (trips: 12h, 3d, …)  ·  deadman-order away-resume
# Setup: ~/.config/deadman/phone.conf with MACHINE=... and TOPIC=... (from `deadman phone-setup` on the laptop),
#        key ~/.ssh/deadman_ed25519 (made with a passphrase: ssh-keygen -t ed25519 -f ~/.ssh/deadman_ed25519 -C deadman-pixel10)
set -euo pipefail
. "$HOME/.config/deadman/phone.conf"      # MACHINE, TOPIC, HOST
KEY="$HOME/.ssh/deadman_ed25519"
action="${1:-}"
case "$action" in test|locate|lost|found|lock|unlock|scrub|wipe|trust|untrust|away-pause|away-resume) ;; *) sed -n '2,13p' "$0"; exit 2 ;; esac
confirm=""; for=""
if [ "$action" = away-pause ]; then
    for="${2:-}"
    [[ "$for" =~ ^[0-9]{1,3}[hd]$ ]] || { echo "usage: deadman-order away-pause 12h | 3d   (1h–30d)"; exit 2; }
fi
if [ "$action" = wipe ]; then
    echo "This makes ALL data on $HOST permanently unrecoverable."
    read -rp "Type  WIPE ${MACHINE:0:8}  to confirm: " confirm
    [ "$confirm" = "WIPE ${MACHINE:0:8}" ] || { echo "not confirmed — nothing sent"; exit 1; }
fi
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
{
    echo "deadman-order v1"
    echo "machine: $MACHINE"
    echo "action: $action"
    echo "issued: $(date +%s)"
    echo "nonce: $(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    [ -n "$confirm" ] && echo "confirm: $confirm"
    [ -n "$for" ] && echo "for: $for"
    true
} >"$tmp/order"
ssh-keygen -Y sign -q -f "$KEY" -n "deadman@$HOST" "$tmp/order"      # asks for the key's passphrase
python3 - "$tmp/order" "$tmp/order.sig" >"$tmp/msg.json" <<'PY'
import json, sys; print(json.dumps({"order": open(sys.argv[1]).read(), "sig": open(sys.argv[2]).read()}))
PY
curl -fsS -m 20 --data-binary @"$tmp/msg.json" "https://ntfy.sh/$TOPIC" >/dev/null
echo "✔ '$action' order sent. The laptop checks every 2 minutes; you'll get an email when it acts."

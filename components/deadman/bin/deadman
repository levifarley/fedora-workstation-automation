#!/bin/bash
# deadman — remote lock / locate / scrub / wipe of this laptop, ordered ONLY from your phone with a signed message
# group: System care
#   deadman                 status: agent polling, armed with your phone key, encrypted disk (needed for a real wipe), lost mode
#   deadman where           where this laptop thinks it is right now (Wi-Fi + IP location; nothing is sent anywhere)
#   deadman log             orders received (accepted and rejected) + away alerts sent
#   deadman away            away-alert state (trusting home + pausing alerts are phone-only orders)
#   deadman selftest        prove the signature checks with a throwaway key (changes nothing)
#   deadman phone-setup     YOU run this: phone steps + your private order channel (needs sudo, real terminal)
#   deadman arm '<key>'     YOU run this: trust your phone's deadman public key (sudo, real terminal)
# Orders are sent from the phone: deadman-order test|locate|lost|found|lock|unlock|scrub|wipe|trust|untrust|away-pause <1h-30d>|away-resume
# Nothing on this laptop can create a valid order — Claude can't arm keys, sign, or run the agent (guard-blocked).
set -uo pipefail
B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; D=$'\e[2m'; N=$'\e[0m'
AGENT=/usr/local/bin/deadman-agent; STATUS=/var/lib/deadman/status.json
need_tty() { [ -t 0 ] && [ -t 1 ] || { echo "Run this yourself in a terminal (needs sudo)."; exit 1; }; }

case "${1:-status}" in
    status)
        [ -x "$AGENT" ] || { echo "${R}✘ not installed${N} — run ~/.config/deadman/install.sh"; exit 1; }
        if [ -r "$STATUS" ]; then
            python3 - "$STATUS" <<'PY'
import json, sys, time
s = json.load(open(sys.argv[1])); age = int(time.time() - s["last_poll"])
G, Y, R, N = "\033[32m", "\033[33m", "\033[31m", "\033[0m"
print(f"{G+'✔' if age < 600 else R+'✘'}{N} agent      last check {age//60} min ago" + (f" — {s['note']}" if s.get("note") else ""))
print(f"{G+'✔' if s['armed'] else Y+'!'}{N} armed      " + ("phone signing key trusted" if s["armed"] else "no phone key yet — deadman phone-setup, then deadman arm"))
print(f"{G+'✔' if s['encrypted'] else Y+'!'}{N} encrypted  " + ("yes — wipe = crypto-erase (seconds, unrecoverable)" if s["encrypted"]
      else "NO — wipe can only scrub secrets + power off (fixed by the encrypted reinstall)"))
print(f"{Y+'!' if s['lost_mode'] else G+'✔'}{N} lost mode  " + ("ON — location emailed every 10 min" if s["lost_mode"] else "off"))
a = s.get("away") or "not checked yet (agent update pending?)"
print(f"{G+'✔' if a == 'home' else R+'✘' if a.startswith('AWAY') else Y+'!'}{N} network    " +
      ("home (trusted router)" if a == "home" else a))
PY
        else echo "${Y}agent installed, hasn't run yet${N}"; fi
        systemctl is-active -q deadman-agent.timer && echo "${D}  timer: every 2 min · orders log: deadman log${N}" ;;
    where)   python3 -I "$AGENT" --locate ;;
    log)     journalctl -t deadman --since -30d --no-pager -o short-iso | tail -30 ;;
    trust-here|trust|untrust)
        echo "${Y}Phone only${N}, so nobody at this keyboard can silence the away alerts. With the laptop on the network,"
        echo "send from the phone:  ${B}~/bin/deadman-order trust${N}   (or: untrust)" ; exit 2 ;;
    away)
        case "${2:-}" in
            pause|resume)
                echo "${Y}Phone only:${N} ${B}~/bin/deadman-order away-pause 3d${N}  ·  ${B}~/bin/deadman-order away-resume${N}"; exit 2 ;;
            *)
                python3 -c 'import json; print("network: " + (json.load(open("/var/lib/deadman/status.json")).get("away") or "not checked yet"))' 2>/dev/null ||
                    echo "agent hasn't run yet"
                echo "${D}  from the phone: deadman-order trust (at home) · away-pause 3d (trips) · away-resume${N}" ;;
        esac ;;
    selftest) python3 -I "$AGENT" --selftest ;;
    phone-setup)
        need_tty
        topic=$(sudo cat /etc/deadman/topic) || exit 1
        # also leave the phone's settings as a file it can fetch with scp (deleted again by `deadman arm`)
        ( umask 077; printf 'MACHINE=%s\nTOPIC=%s\nHOST=%s\n' "$(cat /etc/machine-id)" "$topic" "$(hostname)" >"$HOME/.deadman-phone.conf" )
        echo "${G}Phone settings saved — on the phone run:${N}"
        echo "   mkdir -p ~/.config/deadman ~/bin && scp system:.deadman-phone.conf ~/.config/deadman/phone.conf && scp system:.config/deadman/phone/deadman-order ~/bin/ && chmod +x ~/bin/deadman-order"
        echo
        cat <<EOF
${B}On the phone (Terminal app), one time:${N}
 1. ${B}sudo apt install -y curl python3 openssh-client${N}
 2. Make a SEPARATE key just for deadman orders, ${B}with a passphrase${N} (it's what authorizes a wipe):
      ssh-keygen -t ed25519 -f ~/.ssh/deadman_ed25519 -C deadman-pixel10
 3. Save your settings:
      mkdir -p ~/.config/deadman ~/bin && cat > ~/.config/deadman/phone.conf <<'CFG'
      MACHINE=$(cat /etc/machine-id)
      TOPIC=$topic
      HOST=$(hostname)
      CFG
 4. Copy the order script to the phone (it's ~/.config/deadman/phone/deadman-order on the laptop). Easiest, once ssh works:
      scp system:.config/deadman/phone/deadman-order ~/bin/ && chmod +x ~/bin/deadman-order
 5. Show the deadman PUBLIC key and bring it back to this laptop:
      cat ~/.ssh/deadman_ed25519.pub
    then on the laptop:  ${B}deadman arm '<that line>'${N}
 6. Test the whole chain:  ${B}deadman-order test${N}  → a "test OK" email within ~2 minutes.
${D}Keep the TOPIC private (it's only a channel; orders still need your signature).${N}
EOF
        ;;
    arm)
        need_tty
        shift; key="$*"      # accept the key quoted or unquoted
        [[ "$key" =~ ^ssh-ed25519\ [A-Za-z0-9+/=]{60,}( .*)?$ ]] || { echo "usage: deadman arm 'ssh-ed25519 AAAA... deadman-pixel10'"; exit 2; }
        if grep -qF "$(cut -d' ' -f2 <<<"$key")" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
            echo "${R}That's your SSH login key — use the SEPARATE deadman key (~/.ssh/deadman_ed25519.pub on the phone).${N}"; exit 1
        fi
        echo "deadman namespaces=\"deadman@$(hostname)\" $key" | sudo tee /etc/deadman/allowed_signers >/dev/null &&
            sudo chmod 600 /etc/deadman/allowed_signers &&
            logger -t deadman -p auth.warning -- "phone signing key ARMED by $USER: $(cut -d' ' -f3- <<<"$key")" &&
            { /usr/local/bin/watcher-alert "deadman: phone key armed" "A phone signing key was trusted for remote orders. If this was not you, act now." || echo "(email alert not sent — email not set up yet)"; } &&
            rm -f "$HOME/.deadman-phone.conf" &&
            echo "${G}✔ armed.${N} From the phone: ~/bin/deadman-order test" ;;
    -h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); if (!/^group:/) print; next} NR>1 {exit}' "$0" ;;
    *) echo "unknown: $1 (try: deadman help)"; exit 2 ;;
esac
